#standardSQL

# Utility Functions

# Convert meters to kilometers
# Returns a Float
CREATE TEMPORARY FUNCTION convert_m_to_km (m FLOAT64) AS (m / 1000);

CREATE TEMP FUNCTION s2_level() AS (10);

-- The set of regions is dynamic (sourced from pipe-regions' own registry, see
-- GapEventQuery.template_vars), not hardcoded here -- so this struct's fields always match
-- whatever regions are currently registered, instead of silently drifting out of sync with them.
CREATE TEMP FUNCTION parse_regions_to_struct(regions_str STRING)
  RETURNS STRUCT<{% for region in regions %}{{ region }} ARRAY<STRING>{% if not loop.last %}, {% endif %}{% endfor %}>
  LANGUAGE js AS
"""
    const regions = JSON.parse(regions_str)
{% for region in regions %}    this.{{ region }} = regions.{{ region }} || [];
{% endfor %}    return this;
""";