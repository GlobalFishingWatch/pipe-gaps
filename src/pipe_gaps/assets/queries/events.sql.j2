#standardSQL

-- Include some utility functions
{% include 'utils.sql.j2' %}

-- Parameters of this query:
-- * source_gaps
-- * source_voyages
-- * source_port_visits
-- * source_segment_info
-- * source_segs_activity
-- * source_regions
-- * source_vessels_byyear
-- * start_date
-- * classify_disabling
-- * source_sat_reception (required if classify_disabling)
-- * disabling_min_gap_duration_h (required if classify_disabling)
-- * disabling_min_distance_from_shore_m (required if classify_disabling)
-- * disabling_min_reception_positions_per_day (required if classify_disabling)
-- * disabling_min_positions_before (required if classify_disabling)

WITH

    #################
    # Voyages source 
    #################
    voyages_source as (
        SELECT
            *,
        FROM `{{ source_voyages }}`
    ),

    
    # We need to flatten voyages so that we have a record for each vessel id
    flattened_voyages AS (
        SELECT
            trip_id,
            trip_start,
            trip_end,
            trip_start_anchorage_id,
            trip_end_anchorage_id,
            trip_end_visit_id,
            vessel_id
        FROM voyages_source
        WHERE trip_start != '1979-01-01' OR trip_start IS NULL
    ),

    ########################################################
    # Port visits source, replacing named achorages source #
    ########################################################
    port_visit_source as (
        SELECT
            JSON_EXTRACT_SCALAR(event_info, "$.visit_id") as visit_id,
            *,
        FROM `{{ source_port_visits }}`
    ),


    ############
    # Gaps     #
    ############
    source_gaps AS (
        SELECT
            *,
            EXTRACT(year from start_timestamp) as year,
            -- For a still-open gap, duration_h is NULL (no ON message yet to measure
            -- against). Use the elapsed time up to end_date instead -- the run's own
            -- declared "as of" boundary -- so an open gap can still be evaluated (e.g.
            -- for disabling classification) instead of silently never qualifying.
            -- Deliberately end_date, not CURRENT_TIMESTAMP(): this keeps a historical
            -- backfill reproducible (same inputs, same output) rather than depending on
            -- whenever the query happens to be rerun.
            {% if end_date %}
            COALESCE(
                duration_h,
                TIMESTAMP_DIFF(TIMESTAMP('{{ end_date }}'), start_timestamp, SECOND) / 3600.0
            ) AS effective_duration_h
            {% else %}
            duration_h AS effective_duration_h
            {% endif %}
        FROM
            `{{ source_gaps }}`
        WHERE
          1=1
        {% if start_date %}
          AND DATE(start_timestamp) >= '{{ start_date }}'
        {% endif %}

        {% if end_date %}
          AND (end_timestamp IS NULL OR DATE(end_timestamp) < '{{ end_date }}')
        {% endif %}

        {% if exclude_open_gaps %}
          AND end_timestamp IS NOT NULL
        {% endif %}
    ),

    {% if classify_disabling %}
    ##########################################################
    # Satellite reception quality, for disabling             #
    # classification. Averaged over all time -- matches      #
    # "pipe-gaps-prototype's" own "TEMPORARY" design, not an #
    # improvement on it.                                     #
    ##########################################################
    reception AS (
        SELECT
            lat_bin,
            lon_bin,
            class,
            AVG(positions_per_day) AS positions_per_day
        FROM `{{ source_sat_reception }}`
        GROUP BY 1, 2, 3
    ),
    {% endif %}

    ############
    # Segments #
    ############
    segment_info AS (
      SELECT
        si.seg_id,
        si.vessel_id,
        sa.overlapping_and_short
      FROM `{{ source_segment_info }}` si
      JOIN `{{ source_segs_activity }}` sa USING (seg_id)
    ),


    ################
    # Regions data #
    ################
    regions_source as (
        SELECT
            *,
        FROM `{{ source_regions }}`
    ),

    gridded_regions AS (
        SELECT
            * EXCEPT(s2_cells),
        FROM regions_source
            CROSS JOIN UNNEST (s2_cells) AS s2_cell
    ),

    ##########################
    # Vessels byyear sources #
    ##########################
    source_all_vessels AS (
        SELECT
            *
        FROM `{{ source_vessels_byyear }}`
    ),

    ############### Create base event table ################
    # * Compute event_id.                                  # 
    # * Get base common information.                       # 
    # * Add event_type, vessel_id, seg_id.                 # 
    # * Calculate lat_mean, lot_mean.                      # 
    # * Add vessels, voyages, and port visits information. #
    # * Convert distances to km.                           # 
    ########################################################
    base_gap_event AS (
        SELECT
            TO_HEX(MD5(FORMAT("%s|%s|%t|%t",'gaps', vessel_start.vessel_id, start_timestamp, end_timestamp))) AS event_id,
            'gaps' AS event_type,
            vessel_start.vessel_id,
            s1.seg_id,
            start_timestamp AS event_start,
            end_timestamp AS event_end,
            (start_lat + end_lat) / 2 AS lat_mean,
            (start_lon + end_lon) / 2 AS lon_mean,
            start_lat AS lat_min,
            start_lon AS lon_min,
            end_lat AS lat_max,
            end_lon AS lon_max,
            start_distance_from_shore_m,
            end_distance_from_shore_m,
            start_distance_from_port_m,
            end_distance_from_port_m,
            TO_JSON_STRING(
                STRUCT(
                    effective_duration_h AS duration_h,
                    convert_m_to_km(distance_m) AS total_distance_km,
                    implied_speed_knots,
                    vessel_start.prod_shiptype as vessel_class,
                    STRUCT(
                    -- destination port after event
                        vessel_trip_end_anchorages.event_id AS event_id,
                        SAFE.STRING(PARSE_JSON(vessel_trip_end_anchorages.event_info, wide_number_mode=>'round').intermediate_anchorage.id) as id,
                        SAFE.STRING(PARSE_JSON(vessel_trip_end_anchorages.event_info, wide_number_mode=>'round').intermediate_anchorage.flag) as flag,
                        SAFE.STRING(PARSE_JSON(vessel_trip_end_anchorages.event_info, wide_number_mode=>'round').intermediate_anchorage.name) as name
                    ) as main_vessel_destination_port,
                    s1.vessel_id AS vessel_1_id,
                    s2.vessel_id AS vessel_2_id,
                    s1.vessel_id != s2.vessel_id AS is_multi_vessel_gap,
                    s1.overlapping_and_short AS gap_start_overlapping_and_short,
                    s2.overlapping_and_short AS gap_end_overlapping_and_short,
                    s1.overlapping_and_short AND s2.overlapping_and_short AS gap_overlapping_and_short,
                    LEAST(
                      start_distance_from_port_m,
                      COALESCE(end_distance_from_port_m, start_distance_from_port_m)
                    ) AS gap_min_distance_from_port_m,
                    LEAST(
                      start_distance_from_shore_m,
                      COALESCE(end_distance_from_shore_m, start_distance_from_shore_m)
                    ) AS gap_min_distance_from_shore_m
                    {% if classify_disabling %}
                    ,
                    start_distance_from_shore_m,
                    positions_hours_before_sat,
                    reception.positions_per_day AS positions_per_day_sat_reception,
                    IF(
                        effective_duration_h >= {{ disabling_min_gap_duration_h }}
                        AND start_distance_from_shore_m > {{ disabling_min_distance_from_shore_m }}
                        AND reception.positions_per_day
                            > {{ disabling_min_reception_positions_per_day }}
                        AND positions_hours_before_sat >= {{ disabling_min_positions_before }},
                        true, false
                    ) AS intentional_disabling
                    {% endif %}
                )
            ) AS event_info,
            TO_JSON_STRING(
                ARRAY_CONCAT(
                [
                  STRUCT(
                    gaps.ssvid AS ssvid,
                    vessel_start.vessel_id AS id,
                    vessel_start.{{ vessel_info_field_prefix }}shipname AS name,
                    vessel_start.prod_shiptype AS type,
                    vessel_start.{{ vessel_info_flag_field }} AS flag,
                    s1.seg_id AS seg_id
                  )
                ],
                IF(
                  s2.vessel_id IS NOT NULL
                  AND s2.vessel_id != s1.vessel_id,
                  [
                    STRUCT(
                      gaps.ssvid AS ssvid,
                      vessel_end.vessel_id AS id,
                      vessel_end.{{ vessel_info_field_prefix }}shipname AS name,
                      vessel_end.prod_shiptype AS type,
                      vessel_end.{{ vessel_info_flag_field }} AS flag,
                      s2.seg_id AS seg_id
                    )
                  ],
                  []
                )
              )
            ) AS event_vessels,
        FROM source_gaps AS gaps
            # Join with segments.
            LEFT JOIN segment_info s1 ON gaps.start_seg_id = s1.seg_id
            LEFT JOIN segment_info s2 ON gaps.end_seg_id   = s2.seg_id

            {% if classify_disabling %}
            # Join with satellite reception quality, for disabling classification.
            LEFT JOIN reception ON (
                FLOOR(gaps.start_lat) = reception.lat_bin
                AND FLOOR(gaps.start_lon) = reception.lon_bin
                AND gaps.start_ais_class = reception.class
            )
            {% endif %}

            # Start / OFF vessel (mandatory)
            JOIN source_all_vessels AS vessel_start
              ON vessel_start.vessel_id = s1.vessel_id
             AND vessel_start.year      = gaps.year

            # End / ON vessel (optional, open gaps allowed)
            LEFT JOIN source_all_vessels AS vessel_end
              ON vessel_end.vessel_id = s2.vessel_id
             AND vessel_end.year      = gaps.year

            # Join with voyages.
            LEFT JOIN flattened_voyages AS voyages ON ( 
                vessel_start.vessel_id = voyages.vessel_id
                AND (voyages.trip_start < start_timestamp OR voyages.trip_start IS NULL)
                AND voyages.trip_end > end_timestamp 
            )

            # Join with port port visits.
            LEFT JOIN port_visit_source AS vessel_trip_end_anchorages ON
                voyages.trip_end_visit_id = vessel_trip_end_anchorages.visit_id
    ),

    #
    # Finally, enhance the event with info related to regions and distances.
    #
    total_events AS (
        SELECT
            event_id,
            event_type,
            vessel_id,
            seg_id,
            event_start,
            event_end,
            lat_mean,
            lon_mean,
            lat_min,
            lon_min,
            lat_max,
            lon_max,
            event_info,
            event_vessels,
            ST_GEOGPOINT(lon_mean, lat_mean) as geo,
            S2_CELLIDFROMPOINT(ST_GEOGPOINT(lon_mean, lat_mean), s2_level()) as s2_cell,
            convert_m_to_km(start_distance_from_shore_m) AS start_distance_from_shore_km,
            convert_m_to_km(end_distance_from_shore_m) AS end_distance_from_shore_km,
            convert_m_to_km(start_distance_from_port_m) AS start_distance_from_port_km,
            convert_m_to_km(end_distance_from_port_m) AS end_distance_from_port_km,
        FROM
            base_gap_event
    ),

    # Match events with regions geographically.
    create_event_region_matches AS (
        SELECT
            events.event_id,
            id,
            layer,
        FROM
            total_events AS events
            JOIN gridded_regions r ON events.s2_cell = r.s2_cell
        WHERE ST_INTERSECTS(events.geo, r.geo)
    ),

    # Group events by event_id, layer, and id
    event_by_layer_by_id AS (
        SELECT
            event_id,
            layer,
            id
        FROM create_event_region_matches
        GROUP BY
            1,
            2,
            3
    ),

    # Group events by layer.
    events_by_layer AS (
        SELECT
            event_id, CONCAT('"', layer, '":' ,TO_JSON_STRING(array_agg(id))) AS json_frament
        FROM event_by_layer_by_id
        GROUP BY
            event_id,
            layer
    ),

    # Enrich events with regions.
    event_with_region AS (
        SELECT
            event_id,
            parse_regions_to_struct(CONCAT( "{", STRING_AGG(json_frament, ","), "}")) AS regions
        FROM events_by_layer
        GROUP BY
            1
    )

    # Enrich events with regions.
    SELECT
        total_events.* EXCEPT (s2_cell, geo),
        event_with_region.regions AS regions_mean_position
    FROM
        total_events
        LEFT JOIN event_with_region USING (event_id)
